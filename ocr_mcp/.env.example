# 复制为 .env 或写入 Claude Code MCP 的 env 块（不要把真实 Key 提交到 Git）
VISION_API_KEY=
# 留空则使用 OpenAI SDK 默认 https://api.openai.com/v1
# 阿里云 DashScope OpenAI 兼容示例：
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_BASE_URL=
# 须为支持图像的模型，例如 qwen-vl-plus、qwen-vl-max、gpt-4o 等
VISION_MODEL=
# 可选，覆盖默认 max_tokens
# VISION_MAX_TOKENS=4096
